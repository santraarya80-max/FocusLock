<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121826"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="FOCUS LOCK"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E293B"
            android:paddingLeft="16dp"
            android:paddingTop="6dp"
            android:paddingRight="16dp"
            android:paddingBottom="6dp"
            android:text="Ready to Study"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Big Digital Countdown Clock -->
        <TextView
            android:id="@+id/tvTimerDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="monospace"
            android:text="90:00"
            android:textColor="#FFFFFF"
            android:textSize="56sp"
            android:textStyle="bold" />

        <!-- Box to Enter Study Minutes -->
        <EditText
            android:id="@+id/etMinutesInput"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:background="#1E293B"
            android:gravity="center"
            android:hint="Enter minutes (e.g. 90)"
            android:inputType="number"
            android:text="90"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:textSize="18sp" />

        <!-- Start Focus Button (Disappears once started - No Stop Button!) -->
        <Button
            android:id="@+id/btnStartFocus"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#10B981"
            android:text="START FOCUS LOCK"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Strict Pause / Resume Button (Only visible while session is active) -->
        <Button
            android:id="@+id/btnPauseResume"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#F59E0B"
            android:text="PAUSE TIMER (APPS STAY LOCKED)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Today's Study Time Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:background="#1E293B"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTodayStudyTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Study Time: 0 mins"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Button to Turn On Accessibility App Blocker Permission -->
        <Button
            android:id="@+id/btnEnableBlocker"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#334155"
            android:text="Blocker Permission: Tap to Enable"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- Button to Open Select Apps Screen -->
        <Button
            android:id="@+id/btnSelectApps"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#334155"
            android:text="Select Distracting Apps to Block"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- Button to Open Study History Screen -->
        <Button
            android:id="@+id/btnViewHistory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#334155"
            android:text="View Daily Study History"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
