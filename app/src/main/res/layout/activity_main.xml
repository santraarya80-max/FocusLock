
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fl_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOCUSLOCK"
                    android:textColor="@color/fl_text_primary"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="V3  |  INTELLIGENCE"
                    android:textColor="@color/fl_cyan"
                    android:textSize="11sp"
                    android:letterSpacing="0.12" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStreakBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/fl_surface_alt"
                android:padding="12dp"
                android:text="Streak: 0 Days"
                android:textColor="@color/fl_warning"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@color/fl_surface_alt"
            android:padding="12dp"
            android:text="READY TO STUDY"
            android:textColor="@color/fl_success"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/fl_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT STUDY SESSION"
                android:textColor="@color/fl_text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvCurrentSubjectLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Subject: Maths"
                android:textColor="@color/fl_cyan"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimerDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:text="90:00"
                android:textColor="@color/fl_text_primary"
                android:textSize="58sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBarTimerRing"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/fl_cyan" />

            <TextView
                android:id="@+id/tvPauseInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Your focus session is ready"
                android:textColor="@color/fl_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSetupControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@color/fl_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEW STUDY SESSION"
                android:textColor="@color/fl_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SELECT SUBJECT"
                android:textColor="@color/fl_text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSubjMaths"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Maths"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnSubjPhysics"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Physics"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnSubjChem"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Chem"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnSubjOther"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Other"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etSubjectInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/fl_cyan"
                android:hint="Enter subject name"
                android:inputType="textCapWords"
                android:padding="10dp"
                android:text="Maths"
                android:textColor="@color/fl_text_primary"
                android:textColorHint="@color/fl_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="SESSION DURATION"
                android:textColor="@color/fl_text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPreset30"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="30m"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnPreset60"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="60m"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnPreset90"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="90m"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnPreset120"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="120m"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etMinutesInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/fl_cyan"
                android:gravity="center"
                android:hint="Enter minutes"
                android:inputType="number"
                android:text="90"
                android:textColor="@color/fl_text_primary"
                android:textColorHint="@color/fl_text_secondary"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStartFocus"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/fl_cyan"
            android:text="START FOCUS SESSION"
            android:textColor="#080D1A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPauseResume"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/fl_violet"
            android:text="PAUSE SESSION"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/fl_surface"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAILY PERFORMANCE"
                android:textColor="@color/fl_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTodayStudyTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Today's Study Time: 0 mins"
                android:textColor="@color/fl_cyan"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGoalProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Daily Goal (4 hrs): 0% completed"
                android:textColor="@color/fl_text_secondary"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/progressBarDailyGoal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:max="240"
                android:progress="0"
                android:progressTint="@color/fl_violet" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="FOCUS CONTROLS"
            android:textColor="@color/fl_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <Button
            android:id="@+id/btnEnableBlocker"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/fl_surface_alt"
            android:text="Blocker Permission"
            android:textColor="@color/fl_text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSelectApps"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/fl_surface_alt"
            android:text="Manage Distracting Apps"
            android:textColor="@color/fl_text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnViewHistory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/fl_surface_alt"
            android:text="Study History"
            android:textColor="@color/fl_text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="DATA & BACKUP"
            android:textColor="@color/fl_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnExportBackup"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/fl_surface_alt"
            android:text="Export Backup"
            android:textColor="@color/fl_text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRestoreBackup"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/fl_surface_alt"
            android:text="Restore Backup"
            android:textColor="@color/fl_text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:padding="12dp"
            android:text="FOCUSLOCK V3  •  BUILT FOR DEEP WORK"
            android:textColor="@color/fl_text_secondary"
            android:textSize="10sp" />

    </LinearLayout>
</ScrollView>
