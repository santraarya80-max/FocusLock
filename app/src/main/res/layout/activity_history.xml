<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121826"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Study History and Subjects"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTotalStudyTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#1E293B"
        android:padding="12dp"
        android:text="Total Study Time: 0 mins"
        android:textColor="#10B981"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Subject Breakdown Card -->
    <TextView
        android:id="@+id/tvSubjectBreakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:background="#1E293B"
        android:padding="12dp"
        android:text="Study Time by Subject:\nNo subjects recorded yet."
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Day-by-Day Log:"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/listViewHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E293B"
        android:divider="#334155"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnBackFromHistory"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#334155"
        android:text="BACK TO HOME SCREEN"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

</LinearLayout>
