<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions needed for Focus Lock -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_lock_idle_lock"
        android:label="Focus Lock"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- Screen 1: Home Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: Select Apps Screen -->
        <activity
            android:name=".AppSelectActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Screen 3: Study History Screen -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Screen 4: Full-Screen Block Screen -->
        <activity
            android:name=".BlockedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait" />

        <!-- Background Timer & Small Notification Engine -->
        <service
            android:name=".TimerService"
            android:enabled="true"
            android:exported="false" />

        <!-- App Blocker Accessibility Guard -->
        <service
            android:name=".BlockerAccessibilityService"
            android:enabled="true"
            android:exported="true"
            android:label="Focus Lock App Blocker"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
